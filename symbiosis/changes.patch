+    android:shape="rectangle">
+    <gradient
+        android:angle="270"
+        android:centerColor="#0E1116"
+        android:centerY="0.32"
+        android:endColor="#0E1116"
+        android:startColor="#16223C"
+        android:type="linear" />
+</shape>
