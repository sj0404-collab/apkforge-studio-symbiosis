+            intro = "Список показывает все файлы в выбранных папках, а не только те, " +
+                "что запускаются. Поэтому «игр нет» больше не значит «файлы не нашлись».",
+            steps = listOf(
+                Step(
+                    "Строка сверху",
+                    "Например: «12 игр · 3 обновления · 40 сжатых → Конвертер · 2 не читаются». " +
+                        "Это счёт по всем папкам сразу, без фильтров."
+                ),
+                Step(
+                    "Метка на плитке",
+                    "nsp, xci, nca, nro - формат файла. Обновления и DLC стоят рядом " +
+                        "со своей игрой отдельными плитками: так видно, что установлено."
+                ),
+                Step(
+                    "Пометка справа",
+                    "«сжатый» - образ упакован (NSZ/XCZ/NCZ) и сначала распаковывается. " +
+                        "«нет ключей» - заголовок не расшифровался. «часть» - разрезанный " +
+                        "образ, нужны все части."
+                ),
+                Step(
+                    "Фильтры и поиск",
+                    "«Запускается» прячет всё, что не откроется. Поиск ищет по названию, " +
+                        "Title ID и имени файла."
+                ),
+                Step(
+                    "Долгое нажатие",
+                    "Свойства конкретной игры: настройки только для неё, сейвы, удаление. " +
+                        "Остальные игры это не затрагивает."
+                )
+            )
+        ),
+        Section(
+            id = "dead",
+            title = "Файл виден, но не запускается",
+            intro = "Нажмите такую плитку - приложение скажет причину словами и предложит " +
+                "действие. Причин три, и решения у них разные.",
+            steps = listOf(
+                Step(
+                    "Сжатый NSZ / XCZ / NCZ",
+                    "«Конвертер» → выбрать файл → подождать. Распаковка идёт на телефоне и " +
+                        "занимает столько же места, сколько сам образ: освободите его заранее. " +
+                        "Готовый NSP появится в папке конвертера и сразу в библиотеке."
+                ),
+                Step(
+                    "Часть разрезанного образа (.nsp.00, .xci.01)",
+                    "Ядро открывает только целый файл. Положите все части в одну папку - " +
+                        "библиотека склеит их в одну игру и уберёт лишние плитки."
+                ),
+                Step(
+                    "Нет ключей",
+                    "«Ключи» → prod.keys, затем прошивка. После установки нажмите " +
+                        "«Искать игры»: заголовки расшифруются, и плитки станут запускаемыми. " +
+                        "Файлы при этом никуда не переносятся."
+                )
+            ),
+            actions = listOf(Action("Открыть конвертер", Go.CONVERT), Action("Открыть ключи", Go.KEYS))
+        ),
+        Section(
+            id = "map",
+            title = "Где что лежит",
+            intro = "Все экраны по порядку. Главное - здесь; остальное открывается кнопками " +
+                "сверху или из «Инструментов».",
+            steps = listOf(
+                Step("Библиотека (этот экран)", "Стартовый экран: игры, поиск, запуск."),
+                Step("Папки", "Откуда берутся игры: добавить или убрать папку и посмотреть, что в ней лежит."),
+                Step("Конвертер", "Распаковка сжатых образов; здесь же лежат готовые NSP и очередь заданий."),
+                Step("Ключи", "prod.keys и файлы прошивки консоли. Без них заголовки дампов не расшифровываются."),
+                Step(
+                    "Инструменты",
+                    "Всё остальное: подбор FPS, диагностика, два ядра, утилиты ROM, сейвы, " +
+                        "лаунчеры, справочник настроек."
+                ),
+                Step(
+                    "Два ядра",
+                    "Гибрид: Eden и Kenji-NX в одном приложении, у каждого свои настройки. " +
+                        "Здесь же ядро по умолчанию."
+                ),
+                Step("Руководство (этот экран)", "Инструкция, которую вы читаете; сверху — поиск по ней."),
+                Step(
+                    "Расширенная панель",
+                    "Старая универсальная панель: пространства, выбор ядра, тонкие " +
+                        "переключатели. Нужна редко и для обычной игры не требуется."
+                )
+            ),
+            actions = listOf(Action("Открыть инструменты", Go.TOOLS))
+        ),
+        Section(
+            id = "cores",
+            title = "Два ядра: гибрид",
+            intro = "В приложении два ядра — Eden и Kenji-NX. Где одно падает, другое иногда " +
+                "едет, поэтому ядро выбирается не на всё приложение, а на игру.",
+            steps = listOf(
+                Step(
+                    "Выбрать ядро для игры",
+                    "Долгое нажатие на плитке в библиотеке → «Запустить на Eden» или " +
+                        "«Запустить на Kenji-NX». Выбор запомнится за этой игрой, а пометка " +
+                        "«kenji» на плитке покажет, каким ядром она пойдёт."
+                ),
+                Step(
+                    "Скачать второе ядро",
+                    "«Инструменты» → «Два ядра» → «Скачать», около 55 МБ один раз. Игры, сейвы " +
+                        "и ключи общие: скачивается только ядро, библиотеку заново не собираете."
+                ),
+                Step(
+                    "Как связаны настройки",
+                    "Общие строки — масштаб, док, кэш шейдеров, NCE — второй ядро берёт у Eden, " +
+                        "пока вы не измените их на экране «Два ядра». Свои — память, PPTC, " +
+                        "macro HLE, анизотропия, интернет — принадлежат только ему, и Eden их " +
+                        "не перетирает."
+                ),
+                Step(
+                    "Если второе ядро не скачано",
+                    "Игра всё равно запустится — на Eden, и приложение скажет, почему не на том " +
+                        "ядре. Молча запускать не то хуже, чем сказать."
+                )
+            ),
+            actions = listOf(Action("Открыть два ядра", Go.ENGINES))
+        ),
+        Section(
+            id = "speed",
+            title = "Если медленно",
+            intro = "На Mali-G57 с 8 ГБ помогает не «включить всё», а изменить три вещи.",
+            steps = listOf(
+                Step(
+                    "Масштаб 0.75x",
+                    "Настройки → Графика → Разрешение. Заметная часть работы GPU уходит на " +
+                        "пиксели, которых на экране телефона не видно."
+                ),
+                Step(
+                    "Подбор FPS",
+                    "«Инструменты» → «Подбор FPS»: ставит настройки под это устройство, " +
+                        "а не «максимум качества»."
+                ),
+                Step(
+                    "Диагностика",
+                    "Показывает, какие настройки доехали до драйвера, а какие Mali молча " +
+                        "выбросил. «Включено, но не работает» здесь - обычное дело."
+                )
+            ),
+            actions = listOf(Action("Подбор FPS", Go.FPS), Action("Диагностика", Go.DIAGNOSTICS))
+        ),
+        Section(
+            id = "data",
+            title = "Сейвы, папка данных, перенос",
+            intro = "Сейвы живут не рядом с играми, а в папке данных приложения.",
+            steps = listOf(
+                Step(
+                    "Где сейвы",
+                    "Папка данных (по умолчанию - внутренняя память приложения) → saves. " +
+                        "Свойства игры показывают «сейв 128 КБ», если он уже есть."
+                ),
+                Step(
+                    "Сменить папку данных",
+                    "«Инструменты» → «Утилиты» → сменить папку данных, затем перезапустить " +
+                        "приложение. Папку с играми это не затрагивает."
+                ),
+                Step(
+                    "Перенос на другой телефон",
+                    "Скопируйте папку данных целиком: там сейвы, шейдеры и настройки игр. " +
+                        "Игры можно не копировать - достаточно заново указать папку."
+                )
+            )
+        ),
+        Section(
+            id = "trouble",
+            title = "Если что-то не так: порядок проверки",
+            intro = "Проверяйте сверху вниз, пока не найдётся причина. Каждый пункт - один экран.",
+            steps = listOf(
+                Step("Список пуст", "«Папки» → добавить папку. Если папка уже есть - потяните список вниз: это повторный обход."),
+                Step("Игра не запускается", "Нажмите плитку: причина будет в диалоге. Чаще всего - нет ключей или образ сжатый."),
+                Step("Чёрный экран или вылет", "«Инструменты» → «Диагностика» → отчёт о запуске: видно, что ядро приняло, а что выбросило."),
+                Step(
+                    "Одна игра идёт, другая нет",
+                    "«Инструменты» → «Два ядра»: переключите игру на Kenji-NX долгим нажатием " +
+                        "на плитке. Игра, которая не идёт на одном, иногда идёт на другом."
+                )
+            ),
+            actions = listOf(Action("Диагностика", Go.DIAGNOSTICS), Action("Открыть два ядра", Go.ENGINES))
+        )
+    )
+
+    /**
+     * Поиск по руководству.
+     *
+     * Ищет и по заголовкам, и по тексту шагов: человек помнит слово
+     * «конвертер» или «сжатый», а не название раздела.
+     */
+    fun search(query: String): List<Section> {
+        val q = query.trim().lowercase(Locale.ROOT)
+        if (q.isEmpty()) return sections
+        return sections.filter { section ->
+            section.title.lowercase(Locale.ROOT).contains(q) ||
+                section.steps.any {
+                    it.title.lowercase(Locale.ROOT).contains(q) ||
+                        it.text.lowercase(Locale.ROOT).contains(q)
+                }
+        }
+    }
+
+    /** Заголовки разделов в порядке чтения - для оглавления и тестов. */
+    fun titles(): List<String> = sections.map { it.title }
+
+    /** Все экраны, на которые ссылаются кнопки руководства. */
+    fun referencedScreens(): Set<Go> = sections.flatMap { s -> s.actions.map { it.go } }.toSet()
+}
diff --git a/patch/android/utils/NativeLibraryPresenter.kt b/patch/android/utils/NativeLibraryPresenter.kt
new file mode 100644
index 0000000..4d339ae
--- /dev/null
+++ b/patch/android/utils/NativeLibraryPresenter.kt
@@ -0,0 +1,300 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package org.yuzu.yuzu_emu.utils
+
+import java.util.Locale
+
+/**
+ * Что показывает нативный лаунчер и что делает нажатие.
+ *
+ * Раньше эту работу делала страница в WebView (`library.html`): она решала,
+ * что попадёт в карусель, какие плитки нерабочие, какое действие предложить
+ * и как это назвать. Из-за этого половина интерфейса была в JavaScript, а
+ * половина — в Kotlin, и понять, где что лежит, было нельзя.
+ *
+ * Здесь всё, что можно решить без Android: набор элементов, их порядок,
+ * бейджи, действия и строка сводки. Экран ([org.yuzu.yuzu_emu.fragments.
+ * NativeLauncherFragment]) только рисует то, что вернул этот класс, поэтому
+ * логику можно проверить на хосте (`tests/NativeLibraryPresenterTest.kt`),
+ * не собирая APK.
+ */
+object NativeLibraryPresenter {
+
+    /** Что делает нажатие на элемент. */
+    enum class Action {
+        /** Игра запускается. */
+        LAUNCH,
+        /** Сжатый образ: предложить распаковку. */
+        CONVERT,
+        /** Заголовок не прочитан: нужны ключи и прошивка. */
+        KEYS,
+        /** Часть разрезанного образа: склеивается с соседями. */
+        EXPLAIN_SPLIT
+    }
+
+    /** Строка библиотеки. */
+    data class Row(
+        val title: String,
+        val path: String,
+        /** `0100…` в hex, пустая строка если нет. */
+        val titleId: String = "",
+        val developer: String = "",
+        val fileName: String = "",
+        val hasSave: Boolean = false,
+        val saveSize: String = "",
+        /**
+         * Ядро, которым запустится игра: `kenji` или пусто (Eden).
+         *
+         * Библиотека одна, ядер два. Пометка нужна, чтобы выбор был виден
+         * до нажатия: иначе «я переключил ядро» и «эта игра всё равно
+         * запустилась не тем» выглядят одинаково.
+         */
+        val core: String = ""
+    )
+
+    /** Файл, который виден, но не запускается. */
+    data class Side(
+        val name: String,
+        val path: String,
+        val title: String,
+        val reason: String,
+        /** `compressed`, `unreadable`, `split`. */
+        val kind: String
+    )
+
+    /** Один элемент на экране. */
+    data class Item(
+        val title: String,
+        /** Строка под названием: разработчик, Title ID или причина. */
+        val subtitle: String,
+        /** Короткая метка на плитке: `nsp`, `xci`, `DLC`. */
+        val badge: String,
+        /** Пометка справа: «обновление», «сжатый», «нет ключей». */
+        val note: String,
+        val path: String,
+        val action: Action,
+        val runnable: Boolean,
+        /** `kenji`, если игра пойдёт на втором ядре; пусто для Eden. */
+        val core: String = "",
+        /** Индекс в исходном списке игр, -1 для файлов из [Side]. */
+        val gameIndex: Int = -1
+    )
+
+    /** Что нарисовать. */
+    data class Model(
+        val items: List<Item>,
+        /** Строка над списком: «742 файла · 120 игр · 400 сжатых». */
+        val summary: String,
+        /** То же число словами, когда игр нет: это самый частый вопрос. */
+        val emptyReason: String,
+        val games: Int,
+        val updates: Int,
+        val dlc: Int,
+        val compressed: Int,
+        val unreadable: Int,
+        /** Индекс выбранной плитки в карусели. */
+        val selected: Int = 0
+    )
+
+    /**
+     * Собирает экран.
+     *
+     * Порядок намеренный: сначала то, что запускается, потом обновления и
+     * DLC, и только затем файлы, которые библиотека видит, но открыть не
+     * может. Так «одна игра» из старых жалоб не прячется за четырьмястами
+     * сжатыми образами, но и не исчезает: сжатые идут следом и объяснены.
+     */
+    fun build(
+        games: List<Row>,
+        side: List<Side> = emptyList(),
+        updates: Int = 0,
+        dlc: Int = 0,
+        search: String = "",
+        filter: String = FILTER_ALL
+    ): Model {
+        val query = search.trim().lowercase(Locale.ROOT)
+
+        val gameItems = games.mapIndexed { index, row ->
+            Item(
+                title = row.title.ifBlank { row.fileName.substringBeforeLast('.') },
+                subtitle = subtitleOf(row),
+                badge = extensionOf(row.fileName.ifEmpty { row.path }),
+                note = "",
+                path = row.path,
+                action = Action.LAUNCH,
+                runnable = true,
+                core = row.core,
+                gameIndex = index
+            )
+        }
+
+        val sideItems = side.map { s ->
+            Item(
+                title = s.title.ifBlank { s.name.substringBeforeLast('.') },
+                subtitle = s.reason,
+                badge = extensionOf(s.name.ifEmpty { s.path }),
+                note = when (s.kind) {
+                    "compressed" -> "сжатый"
+                    "split" -> "часть"
+                    "unreadable" -> "нет ключей"
+                    else -> ""
+                },
+                path = s.path,
+                action = when (s.kind) {
+                    "compressed" -> Action.CONVERT
+                    "split" -> Action.EXPLAIN_SPLIT
+                    else -> Action.KEYS
+                },
+                runnable = false,
+                gameIndex = -1
+            )
+        }
+
+        val all = (gameItems + sideItems)
+            .filter { matches(it, query) }
+            .filter { matchesFilter(it, filter) }
+
+        val compressed = side.count { it.kind == "compressed" }
+        val unreadable = side.count { it.kind == "unreadable" }
+        val split = side.count { it.kind == "split" }
+        val gamesCount = games.size
+
+        val onKenji = games.count { it.core == "kenji" }
+
+        return Model(
+            items = all,
+            summary = summaryLine(gamesCount, updates, dlc, compressed, unreadable + split, onKenji),
+            emptyReason = emptyReason(gamesCount, compressed, unreadable + split, games.size + side.size),
+            games = gamesCount,
+            updates = updates,
+            dlc = dlc,
+            compressed = compressed,
+            unreadable = unreadable + split
+        )
+    }
+
+    const val FILTER_ALL = "all"
+    const val FILTER_RUNNABLE = "runnable"
+    const val FILTER_DEAD = "dead"
+
+    private fun matches(item: Item, query: String): Boolean {
+        if (query.isEmpty()) return true
+        return item.title.lowercase(Locale.ROOT).contains(query) ||
+            item.subtitle.lowercase(Locale.ROOT).contains(query)
+    }
+
+    private fun matchesFilter(item: Item, filter: String): Boolean = when (filter) {
+        FILTER_RUNNABLE -> item.runnable
+        FILTER_DEAD -> !item.runnable
+        else -> true
+    }
+
+    private fun subtitleOf(row: Row): String {
+        val bits = mutableListOf<String>()
+        if (row.developer.isNotBlank()) bits.add(row.developer)
+        if (row.titleId.isNotBlank()) bits.add(row.titleId)
+        if (row.hasSave) bits.add("сейв " + row.saveSize.ifBlank { "есть" })
+        return bits.joinToString(" · ")
+    }
+
+    /**
+     * `Game [0100…][v0].nsp` → `nsp`; пусто, если расширения нет.
+     *
+     * Хвост разрезанного образа отрезается: у `Big.nsp.00` на плитке должно
+     * стоять `nsp`, а не `00` — иначе бейдж ничего не говорит о файле.
+     */
+    fun extensionOf(name: String): String {
+        val base = LibraryIndex.withoutSplitSuffix(name.substringAfterLast('/')).first
+        val ext = base.substringAfterLast('.', "").lowercase(Locale.ROOT)
+        return if (ext.length in 2..4 && ext.all { it.isLetterOrDigit() }) ext else ""
+    }
+
+    /**
+     * Строка сводки.
+     *
+     * Считает слова правильно: «1 игра», «2 игры», «5 игр». Раньше панель
+     * писала «1 сжатых» и «3 файлов», и это читалось как ошибка.
+     */
+    fun summaryLine(
+        games: Int,
+        updates: Int,
+        dlc: Int,
+        compressed: Int,
+        broken: Int,
+        onSecondCore: Int = 0
+    ): String {
+        val parts = mutableListOf<String>()
+        parts.add("$games ${plural(games, "игра", "игры", "игр")}")
+        if (onSecondCore > 0) {
+            // Сколько игр уйдёт на второе ядро — до нажатия, а не после.
+            parts.add("$onSecondCore ${plural(onSecondCore, "на Kenji-NX", "на Kenji-NX", "на Kenji-NX")}")
+        }
+        if (updates > 0) parts.add("$updates ${plural(updates, "обновление", "обновления", "обновлений")}")
+        if (dlc > 0) parts.add("$dlc DLC")
+        if (compressed > 0) {
+            parts.add("$compressed ${plural(compressed, "сжатый", "сжатых", "сжатых")} → Конвертер")
+        }
+        if (broken > 0) parts.add("$broken ${plural(broken, "не читается", "не читаются", "не читаются")}")
+        return parts.joinToString(" · ")
+    }
+
+    /** Почему список пуст — словами, а не «нет игр». */
+    fun emptyReason(games: Int, compressed: Int, broken: Int, files: Int): String = when {
+        files == 0 -> "Папка не выбрана или пуста: «Папки» → добавить папку с играми."
+        games > 0 -> "Ничего не найдено по этому фильтру."
+        compressed > 0 && broken > 0 ->
+            "Игр нет: $compressed ${plural(compressed, "файл", "файла", "файлов")} сжаты, " +
+                "$broken не читаются. Сжатые распаковывает Конвертер, для остальных нужны ключи."
+        compressed > 0 ->
+            "Игр нет: $compressed ${plural(compressed, "файл сжат", "файла сжаты", "файлов сжаты")}. " +
+                "Откройте «Конвертер» → «Распаковать»."
+        broken > 0 ->
+            "Игр нет: $broken ${plural(broken, "файл не читается", "файла не читаются", "файлов не читаются")}. " +
+                "Нужны ключи консоли (prod.keys) и прошивка."
+        else -> "Игр нет — в выбранных папках лежат только посторонние файлы."
+    }
+
+    /** Русское склонение: 1 игра, 2 игры, 5 игр. */
+    fun plural(n: Int, one: String, few: String, many: String): String {
+        val mod100 = Math.abs(n) % 100
+        val mod10 = Math.abs(n) % 10
+        return when {
+            mod100 in 11..14 -> many
+            mod10 == 1 -> one
+            mod10 in 2..4 -> few
+            else -> many
+        }
+    }
+
+    /**
+     * Что написать в диалоге для файла, который не запускается.
+     *
+     * Тексты здесь, а не в экране, чтобы их можно было проверить тестом и
+     * чтобы в них не просочилось имя класса: пользователь должен читать
+     * причину, а не `java.lang.IllegalStateException`.
+     */
+    fun explain(kind: String, name: String, reason: String = ""): Triple<String, String, String> =
+        when (kind) {
+            "compressed" -> Triple(
+                name,
+                "Это сжатый образ ($reason). Ядро открывает только nsp/xci/nca, " +
+                    "поэтому файл сначала распаковывается. Распаковка идёт на телефоне " +
+                    "и занимает столько же места, сколько сам образ.",
+                "Распаковать"
+            )
+            "split" -> Triple(
+                name,
+                "Это часть разрезанного образа. Запускается только целый файл: " +
+                    "положите все части рядом, и библиотека увидит одну игру.",
+                "Понятно"
+            )
+            else -> Triple(
+                name,
+                "Файл на месте, но ядро не прочитало заголовок. Так бывает без ключей " +
+                    "консоли (prod.keys) и прошивки: содержимое дампа зашифровано, и " +
+                    "без них не запустится ни один nsp, xci или nca.",
+                "Где ключи"
+            )
+        }
+}
diff --git a/patch/android/utils/SymbiosisTheme.kt b/patch/android/utils/SymbiosisTheme.kt
new file mode 100644
index 0000000..b5365f3
--- /dev/null
+++ b/patch/android/utils/SymbiosisTheme.kt
@@ -0,0 +1,244 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package org.yuzu.yuzu_emu.utils
+
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+/**
+ * Палитра приложения: один источник цвета для всех экранов.
+ *
+ * ПОЧЕМУ ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ colors.xml
+ *   Цвет здесь зависит не от темы, а от данных: у каждой игры свой оттенок,
+ *   у каждого файла свой цвет формата, у каждого раздела свой акцент. В XML
+ *   такого не выразить — пришлось бы заводить сотню ресурсов и всё равно
+ *   выбирать между ними в коде. Зато чистая функция от строки проверяется
+ *   на хосте: одинаковый Title ID всегда даёт одинаковый цвет, и «плитка
+ *   поменяла цвет после перезапуска» — это тест, а не жалоба.
+ *
+ * ТЁМНАЯ ОСНОВА НАМЕРЕННО
+ *   Игра в эмуляторе — это тёмный экран; светлая панель вокруг него бьёт по
+ *   глазам и съедает контраст картинки. Поэтому база почти чёрная с синим
+ *   уклоном, а цвет приходит акцентами: полоса, кружок с буквой, чип, точка
+ *   у строки настройки.
+ *
+ * ПРАВИЛО ПРО ЧИТАЕМОСТЬ
+ *   Любой акцент проходит через [inkOn]: цвет текста поверх акцента
+ *   выбирается по яркости, а не «белый, потому что красиво». Светло-жёлтый
+ *   чип с белыми буквами — это ровно тот случай, когда «красочно» становится
+ *   нечитаемо.
+ */
+object SymbiosisTheme {
+
+    // ── основа ──────────────────────────────────────────────────────────
+    val BASE = 0xFF0E1116.toInt()        // фон экрана
+    val SURFACE = 0xFF151922.toInt()     // карточка
+    val CARD = 0xFF1B2029.toInt()        // карточка поверх карточки
+    val CARD_HIGH = 0xFF232936.toInt()   // нажатая карточка
+    val TEXT = 0xFFEAF0F6.toInt()
+    val TEXT_DIM = 0xFFA6B2C4.toInt()
+    val OUTLINE = 0xFF2C3444.toInt()
+
+    // ── акценты разделов ────────────────────────────────────────────────
+    val CYAN = 0xFF22D3EE.toInt()      // библиотека
+    val LIME = 0xFFA3E635.toInt()      // папки
+    val AMBER = 0xFFFBBF24.toInt()     // конвертер, предупреждения
+    val VIOLET = 0xFFA78BFA.toInt()    // ключи
+    val PINK = 0xFFF472B6.toInt()      // инструменты, второе ядро
+    val BLUE = 0xFF60A5FA.toInt()      // руководство
+    val MINT = 0xFF34D399.toInt()      // «всё хорошо»
+    val RED = 0xFFF87171.toInt()       // «сюда не пройти»
+
+    /**
+     * Цвет раздела руководства.
+     *
+     * Здесь именно соответствие по смыслу, а не хеш: «с чего начать» —
+     * синий, «файл не запускается» — красный, «два ядра» — розовый, как
+     * второе ядро на всех остальных экранах. Человек, листающий руководство,
+     * узнаёт раздел по цвету раньше, чем прочитает заголовок, и цвет не
+     * должен меняться от того, что раздел передвинули.
+     */
+    fun guideAccent(id: String): Int = when (id.lowercase()) {
+        "start" -> BLUE
+        "library" -> CYAN
+        "dead" -> RED
+        "map" -> LIME
+        "cores" -> PINK
+        "speed" -> AMBER
+        "data" -> VIOLET
+        "trouble" -> 0xFFFB7185.toInt()
+        else -> accent(id)
+    }
+
+    /** Акцент раздела по его ключу. Неизвестный ключ получает свой оттенок. */
+    fun sectionAccent(section: String): Int = when (section.lowercase()) {
+        "library" -> CYAN
+        "folders" -> LIME
+        "converter" -> AMBER
+        "keys" -> VIOLET
+        "tools" -> PINK
+        "guide" -> BLUE
+        "engines" -> MINT
+        "eden" -> 0xFF38BDF8.toInt()
+        "kenji" -> PINK
+        else -> accent(section)
+    }
+
+    // ── цвет игры ───────────────────────────────────────────────────────
+
+    /**
+     * Стабильный хеш строки (FNV-1a).
+     *
+     * Нужен свой, а не [String.hashCode]: тот зафиксирован спецификацией, но
+     * читается как «магия», и на нём легко случайно получить соседние цвета
+     * у соседних Title ID. FNV разбрасывает лучше, а результат всё равно
+     * детерминирован — цвет не «прыгает» между запусками.
+     */
+    fun stableHash(key: String): Int {
+        var h = -2128831035
+        for (ch in key) {
+            h = h xor ch.code
+            h *= 16777619
+        }
+        return h and 0x7FFFFFFF
+    }
+
+    /**
+     * Оттенок для игры: стабильный, яркий, но не кислотный.
+     *
+     * Насыщенность и светлота гуляют в узких пределах намеренно: цвета
+     * должны различаться между собой, но не спорить с белым текстом поверх.
+     */
+    fun accent(key: String): Int {
+        val h = stableHash(key)
+        val hue = (h % 360).toFloat()
+        val sat = 0.58f + (h / 360 % 14) / 100f     // 0.58 … 0.71
+        val light = 0.58f + (h / 5040 % 8) / 100f   // 0.58 … 0.65
+        return hsl(hue, sat, light)
+    }
+
+    /** Второй оттенок для градиента: тот же цвет, сдвинутый по кругу. */
+    fun accentPartner(key: String): Int {
+        val h = stableHash(key)
+        val hue = ((h % 360) + 28).toFloat()
+        return hsl(hue, 0.55f, 0.62f)
+    }
+
+    /**
+     * Фон плитки: от почти чёрного к цвету игры.
+     *
+     * Градиент слабый (16 %) и вертикальный: карточка должна намекать на
+     * цвет, а не перекрашиваться целиком — иначе названия игр перестают
+     * читаться на пёстром фоне.
+     */
+    fun tileGradient(key: String): Pair<Int, Int> =
+        mix(CARD, accent(key), 0.16f) to CARD
+
+    // ── формат файла ────────────────────────────────────────────────────
+
+    /**
+     * Цвет по метке формата.
+     *
+     * Формат — единственное, что человек ищет глазами в списке из сотен
+     * строк: `nsp` и `xci` должны различаться цветом, а не прочтением.
+     */
+    fun formatColor(badge: String): Int = when (badge.lowercase().trim()) {
+        "nsp" -> CYAN
+        "xci" -> LIME
+        "nsz" -> AMBER
+        "dlc", "nsp+dlc" -> VIOLET
+        "upd", "обновление" -> BLUE
+        "" -> TEXT_DIM
+        else -> accent(badge)
+    }
+
+    // ── буква на плитке ─────────────────────────────────────────────────
+
+    /**
+     * Буква-монограмма для игры: первая осмысленная буква названия.
+     *
+     * Артикли пропускаются: у половины библиотеки это «The», и все плитки
+     * получили бы одну и ту же букву. Если буквы нет вовсе — берётся первая
+     * цифра, иначе решётка.
+     */
+    fun monogram(title: String): String {
+        val cleaned = title.trim()
+        if (cleaned.isEmpty()) return "#"
+        val words = cleaned.split(' ', '\t', '\n').filter { it.isNotEmpty() }
+        val skip = setOf("the", "a", "an", "super", "new")
+        // Идём по словам, а не берём первое: «🎮 Mario» — первый токен вообще
+        // не слово, и монограмма из решётки на половине библиотеки выглядела
+        // бы как сломанная иконка.
+        for (word in words) {
+            if (word.lowercase().trim('.', ':', '-') in skip) continue
+            val ch = word.firstOrNull { it.isLetterOrDigit() }
+            if (ch != null) return ch.uppercase()
+        }
+        // Название целиком из артикля («The») — решётка была бы загадкой,
+        // поэтому берём его первую букву.
+        return cleaned.firstOrNull { it.isLetterOrDigit() }?.uppercase() ?: "#"
+    }
+
+    // ── мелочи, без которых «красиво» ломается ──────────────────────────
+
+    /**
+     * Цвет текста поверх [background]: тёмный или светлый, по яркости.
+     *
+     * Порог 0.19 — не «эстетическая середина», а точка, где оба варианта
+     * дают одинаковый контраст. При нём относительный контраст не падает
+     * ниже 4.2:1 ни для одного из наших акцентов (проверяется тестом).
+     * Порог 0.5, который так и просится, оставляет узкую полосу цветов,
+     * где нечитаемо и белое, и тёмное.
+     */
+    fun inkOn(background: Int): Int = if (luminance(background) > 0.19f) BASE else TEXT
+
+    /** Тот же цвет с прозрачностью — для подложек и обводок. */
+    fun soft(color: Int, alpha: Float): Int {
+        val a = (alpha.coerceIn(0f, 1f) * 255).roundToInt()
+        return (a shl 24) or (color and 0x00FFFFFF)
+    }
+
+    /** Смешение двух цветов: t = 0 → [a], t = 1 → [b]. Альфа берётся у [a]. */
+    fun mix(a: Int, b: Int, t: Float): Int {
+        val k = t.coerceIn(0f, 1f)
+        fun ch(shift: Int): Int {
+            val ca = (a shr shift) and 0xFF
+            val cb = (b shr shift) and 0xFF
+            return (ca + (cb - ca) * k).roundToInt().coerceIn(0, 255)
+        }
+        return ((a ushr 24) shl 24) or (ch(16) shl 16) or (ch(8) shl 8) or ch(0)
+    }
+
+    /** Относительная яркость по WCAG: по ней и решается, какой цвет текста. */
+    fun luminance(color: Int): Float {
+        fun lin(c: Int): Float {
+            val v = c / 255f
+            return if (v <= 0.03928f) v / 12.92f else Math.pow(((v + 0.055f) / 1.055f).toDouble(), 2.4).toFloat()
+        }
+        val r = lin((color shr 16) and 0xFF)
+        val g = lin((color shr 8) and 0xFF)
+        val b = lin(color and 0xFF)
+        return 0.2126f * r + 0.7152f * g + 0.0722f * b
+    }
+
+    /** HSL → ARGB. Своя, потому что android.graphics недоступен в тесте. */
+    fun hsl(hue: Float, sat: Float, light: Float): Int {
+        val h = ((hue % 360f) + 360f) % 360f / 60f
+        val s = sat.coerceIn(0f, 1f)
+        val l = light.coerceIn(0f, 1f)
+        val c = (1f - abs(2f * l - 1f)) * s
+        val x = c * (1f - abs(h % 2f - 1f))
+        val (r1, g1, b1) = when {
+            h < 1f -> Triple(c, x, 0f)
+            h < 2f -> Triple(x, c, 0f)
+            h < 3f -> Triple(0f, c, x)
+            h < 4f -> Triple(0f, x, c)
+            h < 5f -> Triple(x, 0f, c)
+            else -> Triple(c, 0f, x)
+        }
+        val m = l - c / 2f
+        fun ch(v: Float) = ((v + m).coerceIn(0f, 1f) * 255f).roundToInt()
+        return (255 shl 24) or (ch(r1) shl 16) or (ch(g1) shl 8) or ch(b1)
+    }
+}
