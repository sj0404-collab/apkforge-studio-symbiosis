diff --git a/tests/EngineHybridTest.kt b/tests/EngineHybridTest.kt
new file mode 100644
index 0000000..3d52baf
--- /dev/null
+++ b/tests/EngineHybridTest.kt
@@ -0,0 +1,240 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Гибрид: два ядра, одни настройки на двоих.
+//
+// Проверяется [EngineHybrid] — там решается, что из настроек Eden поедет во
+// второе ядро, что останется своим и каким ядром запустится конкретная игра.
+// Экран только рисует результат, а `KenjiBridge` подставляет его в нативные
+// вызовы, поэтому тест читает и тот, и другой файл: логика без проводки до
+// ядра бесполезна, и именно это было сломано (настройки стояли числами в
+// коде).
+//
+// Run: kotlinc tests/EngineHybridTest.kt patch/android/utils/EngineHybrid.kt \
+//        -include-runtime -d /tmp/eh.jar && java -jar /tmp/eh.jar
+
+import java.io.File
+import org.yuzu.yuzu_emu.utils.EngineHybrid
+import org.yuzu.yuzu_emu.utils.EngineHybrid.Core
+import org.yuzu.yuzu_emu.utils.EngineHybrid.Source
+
+private var passed = 0
+private var failed = 0
+private val failures = mutableListOf<String>()
+
+private fun check(name: String, ok: Boolean, detail: String = "") {
+    if (ok) {
+        passed++
+        println("  ok    $name${if (detail.isEmpty()) "" else "   [$detail]"}")
+    } else {
+        failed++
+        failures += name
+        println("  FAIL  $name${if (detail.isEmpty()) "" else "   [$detail]"}")
+    }
+}
+
+private fun eq(name: String, actual: Any?, expected: Any?) =
+    check(name, actual == expected, "получено $actual, ожидалось $expected")
+
+fun main() {
+    println("EngineHybrid — два ядра в одном")
+
+    val eden = EngineHybrid.EdenSnapshot(
+        resolutionScale = 0.75f,
+        docked = false,
+        shaderCache = true,
+        nce = false,
+        ramGb = 8,
+        language = 2,
+        region = 2
+    )
+
+    // ── 1. общие настройки берутся у Eden ───────────────────────────────
+    val seeded = EngineHybrid.seed(eden)
+    eq("масштаб пришёл из Eden", EngineHybrid.trimFloat(seeded.resScale), "0.75")
+    eq("док пришёл из Eden", seeded.enableDockedMode, false)
+    eq("кэш шейдеров пришёл из Eden", seeded.enableShaderCache, true)
+    eq("NCE пришёл из Eden", seeded.useNce, false)
+    eq("язык пришёл из Eden", seeded.systemLanguage, 2)
+    eq("память на 8 ГБ — 4 ГБ", seeded.memoryManagerMode, 2)
+    check("PPTC остаётся своим (включён)", seeded.enablePtc)
+    check("macro HLE остаётся своим (включён)", seeded.enableMacroHLE)
+    eq(
+        "на 12 ГБ памяти ядро получает 6 ГБ",
+        EngineHybrid.seed(eden.copy(ramGb = 12)).memoryManagerMode,
+        3
+    )
+    eq("масштаб ниже 0.25 зажимается", EngineHybrid.trimFloat(EngineHybrid.seed(eden.copy(resolutionScale = 0.1f)).resScale), "0.25")
+    eq("масштаб выше 4 зажимается", EngineHybrid.trimFloat(EngineHybrid.seed(eden.copy(resolutionScale = 9f)).resScale), "4")
+
+    // ── 2. своё значение перекрывает только своё поле ────────────────────
+    val withOwn = EngineHybrid.merge(eden, mapOf("kenji.memory" to "3", "kenji.macroHle" to "false"))
+    eq("своя память победила", withOwn.memoryManagerMode, 3)
+    check("свой macro HLE победил", !withOwn.enableMacroHLE)
+    eq("масштаб всё ещё из Eden", EngineHybrid.trimFloat(withOwn.resScale), "0.75")
+    check("PPTC не тронут", withOwn.enablePtc)
+
+    val scaleOwn = EngineHybrid.merge(eden, mapOf("kenji.scale" to "1.5"))
+    eq("свой масштаб у второго ядра", EngineHybrid.trimFloat(scaleOwn.resScale), "1.5")
+    eq(
+        "и Eden при этом не изменился",
+        EngineHybrid.trimFloat(EngineHybrid.seed(eden).resScale),
+        "0.75"
+    )
+
+    // ── 3. мусор в хранилище не ломает запуск ───────────────────────────
+    val junk = EngineHybrid.merge(
+        eden,
+        mapOf(
+            "kenji.memory" to "восемь",
+            "kenji.scale" to "2147483000",
+            "kenji.nce" to "может быть",
+            "kenji.такого нет" to "1"
+        )
+    )
+    eq("мусор в памяти → значение Eden", junk.memoryManagerMode, 2)
+    eq("мусор в масштабе → значение Eden", EngineHybrid.trimFloat(junk.resScale), "0.75")
+    check("мусор в NCE → значение Eden", !junk.useNce)
+    check("неизвестный ключ молча пропущен", EngineHybrid.apply(seeded, "kenji.foo", "1") == null)
+
+    // ── 4. каждое значение из списка полей применимо ────────────────────
+    var choicesChecked = 0
+    EngineHybrid.FIELDS.forEach { field ->
+        check("у поля «${field.label}» есть варианты", field.choices.size >= 2)
+        field.choices.forEach { choice ->
+            val applied = EngineHybrid.apply(seeded, field.id, choice.value)
+            check(
+                "вариант «${choice.label}» применяется",
+                applied != null && EngineHybrid.raw(applied, field.id) == choice.value,
+                "${field.id}=${choice.value}"
+            )
+            choicesChecked++
+        }
+    }
+    check("проверено вариантов", choicesChecked >= 20, "$choicesChecked")
+    val ids = EngineHybrid.FIELDS.map { it.id }
+    check("id полей уникальны", ids.size == ids.toSet().size)
+    check("подпись текущего значения находится", EngineHybrid.label(seeded, "scale") == "0.75x")
+
+    // ── 5. переключение по кругу не застревает ──────────────────────────
+    var cfg = seeded
+    val seen = mutableSetOf<String>()
+    repeat(EngineHybrid.FIELDS.first { it.id == "memory" }.choices.size) {
+        val next = EngineHybrid.next(cfg, "memory")
+        seen += next
+        cfg = EngineHybrid.apply(cfg, "memory", next) ?: cfg
+    }
+    eq(
+        "круг по памяти обошёл все варианты",
+        seen.size,
+        EngineHybrid.FIELDS.first { it.id == "memory" }.choices.size
+    )
+
+    // ── 6. строки «что куда поедет» ─────────────────────────────────────
+    val rows = EngineHybrid.rows(eden, mapOf("kenji.memory" to "3"))
+    val memory = rows.first { it.id == "memory" }
+    eq("своя память помечена как своё", memory.source, Source.OWN)
+    eq("память 6 ГБ", memory.value, "6 ГБ")
+    val scale = rows.first { it.id == "scale" }
+    eq("масштаб помечен как из Eden", scale.source, Source.EDEN)
+    check("в списке есть и общие, и свои строки", rows.any { it.source == Source.EDEN } && rows.any { it.source == Source.OWN })
+    eq("строк столько же, сколько полей", rows.size, EngineHybrid.FIELDS.size)
+
+    // ── 7. ядро на игру ────────────────────────────────────────────────
+    eq("по умолчанию Eden", EngineHybrid.coreFor("eden", null), Core.EDEN)
+    eq("игра переопределила на Kenji", EngineHybrid.coreFor("eden", "kenji"), Core.KENJI)
+    eq("игра вернулась на Eden", EngineHybrid.coreFor("kenji", "eden"), Core.EDEN)
+    eq("без своего значения — общее", EngineHybrid.coreFor("kenji", null), Core.KENJI)
+    eq("мусор в значении — Eden", EngineHybrid.coreFor("eden", "quake"), Core.EDEN)
+    check("ключи игр различаются", EngineHybrid.gameKey("content://a/Game 1.nsp") != EngineHybrid.gameKey("content://a/Game 2.nsp"))
+    eq("ключ игры стабилен", EngineHybrid.gameKey("content://a/x.nsp"), EngineHybrid.gameKey("content://a/x.nsp"))
+    eq("длина ключа игры", EngineHybrid.gameKey("content://a/x.nsp").length, 16)
+    eq("пустой путь — пустой ключ", EngineHybrid.gameKey(""), "")
+
+    // ── 8. сводка для человека ──────────────────────────────────────────
+    val summary = EngineHybrid.summary(withOwn)
+    check("сводка называет масштаб", summary.contains("масштаб"), summary)
+    check("сводка называет память", summary.contains("6 ГБ"), summary)
+    check("сводка называет NCE", summary.contains("NCE"), summary)
+
+    // ── 8b. передача настроек в процесс :kenji ──────────────────────────
+    val eff = EngineHybrid.effective(withOwn)
+    eq("в наборе все поля", eff.size, EngineHybrid.FIELDS.size)
+    val encoded = EngineHybrid.encode(eff)
+    check("строка настроек компактна", encoded.length < 400, "${encoded.length} символов")
+    val decoded = EngineHybrid.decode(encoded)
+    eq("разбор вернул столько же полей", decoded.size, eff.size)
+    eq("память пережила передачу", decoded["memory"], "3")
+    eq(
+        "и конфиг из переданного набора совпадает",
+        EngineHybrid.merge(eden, decoded.mapKeys { "kenji." + it.key }).memoryManagerMode,
+        withOwn.memoryManagerMode
+    )
+    eq("мусор в строке пропускается", EngineHybrid.decode("мусор;=;a=;b=1").size, 1)
+    eq("пустая строка — пустой набор", EngineHybrid.decode("").size, 0)
+
+    // ── 9. проводка до ядра, а не только логика ─────────────────────────
+    val root = File(".").absoluteFile
+    if (File(root, "patch/android").isDirectory) {
+        val bridge = File(root, "patch/android/utils/KenjiBridge.kt")
+        if (bridge.isFile) {
+            val src = bridge.readText()
+            check("мост берёт настройки из хранилища", src.contains("EngineStore.config(context)"))
+            val body = src.substringAfter("fun preparePlay", "").substringBefore("fun attachSurface")
+            check(
+                "мост больше не вписывает значения числами",
+                !body.contains("memoryManagerMode = 2") && !body.contains("resScale = 1f"),
+                body.take(120)
+            )
+            check(
+                "каждое поле конфига доезжает до nativeDeviceInit",
+                body.contains("cfg.memoryManagerMode") && body.contains("cfg.enablePtc") &&
+                    body.contains("cfg.resScale") && body.contains("cfg.enableMacroHLE")
+            )
+        } else {
+            check("мост второго ядра существует", false)
+        }
+
+        val launcher = File(root, "patch/android/fragments/NativeLauncherFragment.kt")
+        if (launcher.isFile) {
+            val src = launcher.readText()
+            check("лаунчер спрашивает ядро у хранилища", src.contains("EngineStore.coreFor"))
+            check("лаунчер умеет открыть второе ядро", src.contains("KenjiPlayerActivity.intent"))
+            check("выбор ядра запоминается за игрой", src.contains("EngineStore.setCoreFor"))
+        }
+
+        val engines = File(root, "patch/android/fragments/EnginesFragment.kt")
+        if (engines.isFile) {
+            val src = engines.readText()
+            check("экран ядер показывает связь настроек", src.contains("EngineStore.rows"))
+            check("настройку можно переключить", src.contains("EngineStore.cycleField"))
+            check("значения Eden возвращаются кнопкой", src.contains("EngineStore.resetFields"))
+            check("экран называет оба ядра сразу", src.contains("EngineLoader.Engine.values()"))
+        }
+
+        val manual = File(root, "patch/android/utils/Manual.kt")
+        if (manual.isFile) {
+            check(
+                "в руководстве есть раздел про два ядра",
+                manual.readText().contains("id = \"cores\"")
+            )
+        }
+
+        val store = File(root, "patch/android/utils/EngineStore.kt")
+        if (store.isFile) {
+            check(
+                "схема хранения проверяется",
+                store.readText().contains("EngineHybrid.VERSION")
+            )
+        }
+    } else {
+        println("  note  дерево patch/ рядом не найдено — проверка дрейфа пропущена")
+    }
+
+    println()
+    println("passed=$passed failed=$failed")
+    if (failed > 0) {
+        println("failing: ${failures.joinToString(", ")}")
+        kotlin.system.exitProcess(1)
+    }
+}
diff --git a/tests/LibraryIndexTest.kt b/tests/LibraryIndexTest.kt
new file mode 100644
index 0000000..1420806
--- /dev/null
+++ b/tests/LibraryIndexTest.kt
@@ -0,0 +1,203 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// «Из сотен nsz, nsp, xci видит одну игру».
+//
+// Три разных места решали, что такое игра, и решали по-разному:
+// импортёр (`GameHelper.addGamesRecursive`) брал только запускаемые
+// расширения и молча выбрасывал всё, у чего не прочитался заголовок;
+// сканер папки показывал ещё и nsz; панель считала по кэшу. Сжатый NSZ
+// не открывается ядром -> `GameMetadata.getIsValid` = false -> `getGame()`
+// = null -> записи нет. Сотни файлов давали ноль строк.
+//
+// `LibraryIndex` - одно правило. Тест зовёт именно его, а не модель:
+// файл в тесте и файл в APK - один и тот же исходник.
+//
+// Run: kotlinc tests/LibraryIndexTest.kt patch/android/utils/LibraryIndex.kt \
+//        -include-runtime -d /tmp/li.jar && java -jar /tmp/li.jar
+
+import java.io.File
+import org.yuzu.yuzu_emu.utils.LibraryIndex
+import org.yuzu.yuzu_emu.utils.LibraryIndex.Kind
+
+private var passed = 0
+private var failed = 0
+private val failures = mutableListOf<String>()
+
+private fun check(name: String, ok: Boolean, detail: String = "") {
+    if (ok) {
+        passed++
+        println("  ok    $name${if (detail.isEmpty()) "" else "   [$detail]"}")
+    } else {
+        failed++
+        failures += name
+        println("  FAIL  $name${if (detail.isEmpty()) "" else "   [$detail]"}")
+    }
+}
+
+private fun eq(name: String, actual: Any?, expected: Any?) =
+    check(name, actual == expected, "получено $actual, ожидалось $expected")
+
+fun main() {
+    println("LibraryIndex — одна игра из сотен")
+
+    // ── база, обновление, DLC ────────────────────────────────────────────
+    val base = LibraryIndex.classify("Sonic Mania [01004E300BD5C000][v0].nsp")
+    eq("база: вид", base.kind, Kind.GAME)
+    eq("база: titleId", base.titleId, "01004E300BD5C000")
+    eq("база: имя без тегов", base.title, "Sonic Mania")
+    eq("база: запускается", base.runnable, true)
+
+    val upd = LibraryIndex.classify("Sonic Mania [01004E300BD5C800][v65536][UPD].nsp")
+    eq("обновление: вид", upd.kind, Kind.UPDATE)
+    eq("обновление: версия", upd.version, "1.0.0")
+    eq("обновление: запускается", upd.runnable, true)
+
+    val v131072 = LibraryIndex.classify("Game [01004E300BD5C800][v131072][UPD].nsp")
+    eq("обновление: 131072 = 2.0.0", v131072.version, "2.0.0")
+
+    val dlc = LibraryIndex.classify("Sonic Mania [01004E300BD5C001][DLC] Encore.nsp")
+    eq("DLC: вид", dlc.kind, Kind.DLC)
+    eq("DLC: имя", dlc.title, "Sonic Mania Encore")
+
+    // Роль определяется и без тега [UPD]/[DLC] - по последним 12 битам ID.
+    eq("роль 000 = база", LibraryIndex.roleOf("01004E300BD5C000"), LibraryIndex.Role.BASE)
+    eq("роль 800 = обновление", LibraryIndex.roleOf("01004E300BD5C800"), LibraryIndex.Role.UPDATE)
+    eq("роль 001 = DLC", LibraryIndex.roleOf("01004E300BD5C001"), LibraryIndex.Role.DLC)
+    eq("базовый ID от DLC", LibraryIndex.baseTitleId("01004E300BD5C001"), "01004E300BD5C000")
+
+    // ── сжатые образы: именно они и пропадали ────────────────────────────
+    for (ext in listOf("nsz", "xcz", "ncz")) {
+        val e = LibraryIndex.classify("Zelda [${
+            if (ext == "ncz") "0100000000010000" else "01007EF00011E000"
+        }][v0].$ext")
+        eq("$ext: вид", e.kind, Kind.COMPRESSED)
+        eq("$ext: не запускается", e.runnable, false)
+        check("$ext: причина понятна", e.reason.contains("Конвертер"), e.reason)
+    }
+    check("nsz хочется видеть в библиотеке", LibraryIndex.isWanted("game.nsz"))
+    check("nsp хочется видеть в библиотеке", LibraryIndex.isWanted("game.nsp"))
+    check("xci хочется видеть в библиотеке", LibraryIndex.isWanted("game.xci"))
+    check("txt не хочется", !LibraryIndex.isWanted("keys.txt"))
+    check("nsz не запускается", !LibraryIndex.isRunnable("game.nsz"))
+
+    // ── разрезанный образ: части - не отдельные игры ─────────────────────
+    val p0 = LibraryIndex.classify("Big Game [0100AAAAAAAAA000][v0].nsp.00")
+    val p1 = LibraryIndex.classify("Big Game [0100AAAAAAAAA000][v0].nsp.01")
+    eq("часть 0: вид", p0.kind, Kind.SPLIT_PART)
+    eq("часть 1: вид", p1.kind, Kind.SPLIT_PART)
+    eq("часть: не запускается", p0.runnable, false)
+    eq(
+        "две части - одна запись",
+        LibraryIndex.baseKey("Big Game [0100AAAAAAAAA000][v0].nsp.00") ==
+            LibraryIndex.baseKey("Big Game [0100AAAAAAAAA000][v0].nsp.01"),
+        true
+    )
+    eq("часть обновления - обновление", p0.copy(kind = Kind.UPDATE).kind, Kind.UPDATE)
+    val updPart = LibraryIndex.classify("Big [0100AAAAAAAAA800][v65536][UPD].xci.part01")
+    eq("разрезанное обновление: вид", updPart.kind, Kind.UPDATE)
+
+    // ── распакованная игра ───────────────────────────────────────────────
+    val naked = LibraryIndex.classify("main")
+    eq("main: вид", naked.kind, Kind.UNPACKED)
+    eq("main: запускается", naked.runnable, true)
+    eq("main: имя", naked.title, "main")
+
+    // ── «не игра»: не притворяемся, что папка пуста ──────────────────────
+    val zip = LibraryIndex.classify("backup.7z")
+    eq("архив: вид", zip.kind, Kind.OTHER)
+    check("архив: причина словами", zip.reason.contains("архив"), zip.reason)
+    val txt = LibraryIndex.classify("keys.txt")
+    eq("txt: вид", txt.kind, Kind.OTHER)
+    check("txt: причина без имени класса", !txt.reason.contains(".kt"), txt.reason)
+
+    // ── имена с мусором ──────────────────────────────────────────────────
+    eq(
+        "мусорное имя чистится",
+        LibraryIndex.titleFrom("  [0100AAAAAAAAA000]  Super   Mario  [v0] (1).nsp"),
+        "Super Mario (1)"
+    )
+    eq("пустое имя не падает", LibraryIndex.classify("").kind, Kind.OTHER)
+    eq("имя из одной точки", LibraryIndex.classify(".").kind, Kind.OTHER)
+
+    // ── сводка по папке ──────────────────────────────────────────────────
+    // 200 сжатых + 4 игры + 2 обновления + 3 DLC + мусор.
+    val names = mutableListOf<String>()
+    repeat(200) { names.add("Dump $it [0100AAAAAAAA${"%04X".format(it)}][v0].nsz") }
+    repeat(4) { names.add("Game $it [0100BBBBBBBB${"%04X".format(it)}0000][v0].nsp") }
+    repeat(2) { names.add("Game 0 [0100BBBBBBBB0000${"%04X".format(it + 0x800)}][v${
+        (it + 1) * 65536
+    }][UPD].nsp") }
+    repeat(3) { names.add("Game 0 [0100BBBBBBBB000${"%03X".format(it + 1)}][DLC] x.nsp") }
+    names.add("keys.txt")
+    names.add("readme.md")
+    val s = LibraryIndex.summarise(names)
+    eq("сводка: файлов", s.files, 211)
+    eq("сводка: игр", s.games, 4)
+    eq("сводка: обновлений", s.updates, 2)
+    eq("сводка: DLC", s.dlc, 3)
+    eq("сводка: сжатых", s.compressed, 200)
+    eq("сводка: прочих", s.other, 2)
+    check("сводка: сжатые названы в строке", s.line().contains("200 сжатых"), s.line())
+    check("сводка: игры названы", s.line().contains("4 игры"), s.line())
+
+    // Один и тот же файл, найденный дважды, не удваивает счёт.
+    val dup = LibraryIndex.summarise(listOf("A [0100CCCCCCCC0000][v0].nsp", "A [0100CCCCCCCC0000][v0].nsp"))
+    eq("дубликат схлопнут", dup.games, 1)
+
+    // ── что сломало прошлый обход: имя без точки ─────────────────────────
+    // `getGame()` считал programId как name.substring(0, name.lastIndexOf(".")),
+    // и на файле «main» это substring(0, -1) - исключение на весь обход.
+    val crashProne = LibraryIndex.titleFrom("main")
+    eq("main без точки: имя", crashProne, "main")
+    check(
+        "main без точки: id берётся безопасно",
+        LibraryIndex.titleFrom("main").substringBeforeLast('.', "main") == "main"
+    )
+
+    // ── расхождение с исходниками (то, что модель не поймает) ────────────
+    val root = File(".").absoluteFile
+    val helper = File(root, "patch/android/utils/GameHelper.kt")
+    if (helper.isFile && File(root, "patch/android").isDirectory) {
+        val src = helper.readText()
+        check("GameHelper берёт правило из LibraryIndex", src.contains("LibraryIndex.isWanted"))
+        // В комментарии строка упомянута намеренно - проверяем код, а не
+        // рассказ о нём: ищем именно вызов.
+        check(
+            "GameHelper не режет id через lastIndexOf(\".\")",
+            !src.contains("programId = name.substring(0, name.lastIndexOf")
+        )
+        check("GameHelper не теряет файл при null от getGame", src.contains("side.add(") && src.contains("stats.failed++"))
+        check("GameHelper считает статистику обхода", src.contains("scanStats"))
+
+        val scanner = File(root, "patch/android/utils/GameFolderScanner.kt").readText()
+        check(
+            "сканер не режет обход на 400 папках",
+            !scanner.contains("MAX_DIRECTORIES = 400")
+        )
+        check("сканер считает сжатые", scanner.contains("LibraryIndex.isWanted"))
+
+        val panel = File(root, "patch/android/utils/LivePanel.kt").readText()
+        check("панели есть чем ответить «почему не видно»", panel.contains("libraryReport"))
+
+        val html = File(root, "docs/library.html").readText()
+        val asset = File(root, "patch/android/assets/library.html")
+        check("страница знает про сжатые", html.contains("data-filter=\"dead\"") && html.contains("deadAction"))
+        check("страница показывает сводку", html.contains("paintStats") && html.contains("libraryReport"))
+        if (asset.isFile) {
+            check(
+                "docs/ и assets/ совпадают байт в байт",
+                html == asset.readText()
+            )
+        }
+    } else {
+        println("  note  исходники рядом не найдены - проверка дрейфа пропущена")
+    }
+
+    println()
+    println("passed=$passed failed=$failed")
+    if (failed > 0) {
+        println("failing: ${failures.joinToString(", ")}")
+        kotlin.system.exitProcess(1)
+    }
+}
diff --git a/tests/NativeLibraryPresenterTest.kt b/tests/NativeLibraryPresenterTest.kt
new file mode 100644
index 0000000..9f4530e
--- /dev/null
+++ b/tests/NativeLibraryPresenterTest.kt
@@ -0,0 +1,295 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Нативный лаунчер: та же логика, что у страницы в WebView, но без WebView.
+//
+// Проверяется [NativeLibraryPresenter] - он и есть вся логика: порядок,
+// бейджи, действия, строка сводки, склонения, тексты диалогов. Экран только
+// рисует. Поэтому тест зовёт настоящий презентер, а не модель.
+//
+// Run: kotlinc tests/NativeLibraryPresenterTest.kt \
+//        patch/android/utils/NativeLibraryPresenter.kt patch/android/utils/LibraryIndex.kt \
+//        -include-runtime -d /tmp/np.jar && java -jar /tmp/np.jar
+
+import java.io.File
+import org.yuzu.yuzu_emu.utils.LibraryIndex
+import org.yuzu.yuzu_emu.utils.Manual
+import org.yuzu.yuzu_emu.utils.NativeLibraryPresenter
+import org.yuzu.yuzu_emu.utils.NativeLibraryPresenter.Action
+
+private var passed = 0
+private var failed = 0
+private val failures = mutableListOf<String>()
