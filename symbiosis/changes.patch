diff --git a/patch/android/layout/button_manual_action.xml b/patch/android/layout/button_manual_action.xml
new file mode 100644
index 0000000..a344c0d
--- /dev/null
+++ b/patch/android/layout/button_manual_action.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
+SPDX-License-Identifier: GPL-3.0-or-later
+
+A button under a manual section. Separate file because the style has to exist
+at inflation time: building a MaterialButton in code without a defStyleAttr
