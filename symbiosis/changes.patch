+
+package org.yuzu.yuzu_emu.utils
+
+import java.util.Locale
+
+/**
+ * Инструкция пользования: что где лежит и в каком порядке нажимать.
+ *
+ * Экран библиотеки отвечал на вопрос «что у меня есть», но не на вопрос
+ * «а куда идти дальше». Настройки были в четырёх местах - на главном,
+ * в «Инструментах», за шестерёнкой и в старой панели, - и человек,
+ * который первый раз запускает эмулятор, не мог понять, где ключи, где
+ * папки и почему половина файлов помечена «сжатый».
+ *
+ * Тексты лежат здесь, а не в вёрстке, по двум причинам: их видно в
+ * `docs/GUIDE.md` (тот же порядок разделов) и их можно проверить на хосте
+ * тестом - `tests/NativeLibraryPresenterTest.kt` следит, чтобы каждый
+ * раздел ссылался на экран, который действительно есть в навигации.
+ *
+ * Этот файл намеренно без Android: он собирается обычным kotlinc.
+ */
+object Manual {
+
+    /**
+     * Куда ведёт кнопка раздела.
+     *
+     * Идентификаторы строковых констант, а не `R.id.*`: `R` живёт в
+     * сгенерированном коде и недоступен хост-тесту. Экран
+     * ([org.yuzu.yuzu_emu.fragments.ManualFragment]) переводит [Go] в
+     * действие навигации.
+     */
+    enum class Go {
+        FOLDERS,
+        KEYS,
+        CONVERT,
+        TOOLS,
+        ENGINES,
+        FPS,
+        DIAGNOSTICS,
+        SETTINGS_GUIDE,
+        PANEL
+    }
+
+    /** Один шаг: короткий заголовок и одно-два предложения под ним. */
+    data class Step(val title: String, val text: String)
+
+    /** Кнопка под разделом. */
+    data class Action(val label: String, val go: Go)
+
+    /** Раздел руководства. */
+    data class Section(
+        val id: String,
+        val title: String,
+        val intro: String,
+        val steps: List<Step>,
+        val actions: List<Action> = emptyList()
+    )
+
+    /**
+     * Версия текста.
+     *
+     * Поднимается, когда руководство меняется по существу: так по номеру в
+     * шапке видно, что человек читает новую инструкцию, а не ту, что была
+     * в APK полугодовой давности.
+     */
+    const val VERSION = 2
+
+    /** Все разделы в том порядке, в каком их читают. */
+    val sections: List<Section> = listOf(
+        Section(
+            id = "start",
+            title = "С чего начать: три шага",
+            intro = "Порядок важен. Пока нет ключей, ни один дамп не откроется, " +
+                "и пустой список будет выглядеть как «папка не та», хотя дело не в ней.",
+            steps = listOf(
+                Step(
+                    "1. Ключи и прошивка",
+                    "«Ключи» → prod.keys, затем файлы прошивки. Без них заголовок " +
+                        "файла зашифрован: приложение видит файл, но не знает, что это " +
+                        "за игра, и помечает его «нет ключей»."
+                ),
+                Step(
+                    "2. Папка с играми",
+                    "«Папки» → «Добавить папку». Выберите папку, где лежат NSP, XCI, " +
+                        "NCA или сжатые NSZ. Папок может быть несколько, вложенность " +
+                        "читается."
+                ),
+                Step(
+                    "3. Нажать игру",
+                    "Вернитесь на этот экран: игры уже в списке. Нажатие запускает игру, " +
+                        "долгое нажатие открывает её свойства - масштаб, драйвер, сейвы."
+                )
