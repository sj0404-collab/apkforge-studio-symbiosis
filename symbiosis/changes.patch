diff --git a/tests/LibraryIndexTest.kt b/tests/LibraryIndexTest.kt
new file mode 100644
index 0000000..1420806
--- /dev/null
+++ b/tests/LibraryIndexTest.kt
@@ -0,0 +1,203 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// «Из сотен nsz, nsp, xci видит одну игру».
+//
+// Три разных места решали, что такое игра, и решали по-разному:
+// импортёр (`GameHelper.addGamesRecursive`) брал только запускаемые
+// расширения и молча выбрасывал всё, у чего не прочитался заголовок;
+// сканер папки показывал ещё и nsz; панель считала по кэшу. Сжатый NSZ
+// не открывается ядром -> `GameMetadata.getIsValid` = false -> `getGame()`
+// = null -> записи нет. Сотни файлов давали ноль строк.
+//
+// `LibraryIndex` - одно правило. Тест зовёт именно его, а не модель:
+// файл в тесте и файл в APK - один и тот же исходник.
+//
+// Run: kotlinc tests/LibraryIndexTest.kt patch/android/utils/LibraryIndex.kt \
+//        -include-runtime -d /tmp/li.jar && java -jar /tmp/li.jar
+
+import java.io.File
+import org.yuzu.yuzu_emu.utils.LibraryIndex
+import org.yuzu.yuzu_emu.utils.LibraryIndex.Kind
+
+private var passed = 0
+private var failed = 0
+private val failures = mutableListOf<String>()
+
+private fun check(name: String, ok: Boolean, detail: String = "") {
+    if (ok) {
+        passed++
+        println("  ok    $name${if (detail.isEmpty()) "" else "   [$detail]"}")
+    } else {
+        failed++
+        failures += name
+        println("  FAIL  $name${if (detail.isEmpty()) "" else "   [$detail]"}")
+    }
+}
+
+private fun eq(name: String, actual: Any?, expected: Any?) =
+    check(name, actual == expected, "получено $actual, ожидалось $expected")
+
+fun main() {
+    println("LibraryIndex — одна игра из сотен")
+
+    // ── база, обновление, DLC ────────────────────────────────────────────
+    val base = LibraryIndex.classify("Sonic Mania [01004E300BD5C000][v0].nsp")
+    eq("база: вид", base.kind, Kind.GAME)
+    eq("база: titleId", base.titleId, "01004E300BD5C000")
+    eq("база: имя без тегов", base.title, "Sonic Mania")
+    eq("база: запускается", base.runnable, true)
+
+    val upd = LibraryIndex.classify("Sonic Mania [01004E300BD5C800][v65536][UPD].nsp")
+    eq("обновление: вид", upd.kind, Kind.UPDATE)
+    eq("обновление: версия", upd.version, "1.0.0")
+    eq("обновление: запускается", upd.runnable, true)
+
+    val v131072 = LibraryIndex.classify("Game [01004E300BD5C800][v131072][UPD].nsp")
+    eq("обновление: 131072 = 2.0.0", v131072.version, "2.0.0")
+
+    val dlc = LibraryIndex.classify("Sonic Mania [01004E300BD5C001][DLC] Encore.nsp")
+    eq("DLC: вид", dlc.kind, Kind.DLC)
+    eq("DLC: имя", dlc.title, "Sonic Mania Encore")
+
+    // Роль определяется и без тега [UPD]/[DLC] - по последним 12 битам ID.
+    eq("роль 000 = база", LibraryIndex.roleOf("01004E300BD5C000"), LibraryIndex.Role.BASE)
+    eq("роль 800 = обновление", LibraryIndex.roleOf("01004E300BD5C800"), LibraryIndex.Role.UPDATE)
+    eq("роль 001 = DLC", LibraryIndex.roleOf("01004E300BD5C001"), LibraryIndex.Role.DLC)
+    eq("базовый ID от DLC", LibraryIndex.baseTitleId("01004E300BD5C001"), "01004E300BD5C000")
+
+    // ── сжатые образы: именно они и пропадали ────────────────────────────
+    for (ext in listOf("nsz", "xcz", "ncz")) {
+        val e = LibraryIndex.classify("Zelda [${
+            if (ext == "ncz") "0100000000010000" else "01007EF00011E000"
+        }][v0].$ext")
+        eq("$ext: вид", e.kind, Kind.COMPRESSED)
+        eq("$ext: не запускается", e.runnable, false)
+        check("$ext: причина понятна", e.reason.contains("Конвертер"), e.reason)
+    }
+    check("nsz хочется видеть в библиотеке", LibraryIndex.isWanted("game.nsz"))
+    check("nsp хочется видеть в библиотеке", LibraryIndex.isWanted("game.nsp"))
+    check("xci хочется видеть в библиотеке", LibraryIndex.isWanted("game.xci"))
+    check("txt не хочется", !LibraryIndex.isWanted("keys.txt"))
+    check("nsz не запускается", !LibraryIndex.isRunnable("game.nsz"))
+
+    // ── разрезанный образ: части - не отдельные игры ─────────────────────
+    val p0 = LibraryIndex.classify("Big Game [0100AAAAAAAAA000][v0].nsp.00")
+    val p1 = LibraryIndex.classify("Big Game [0100AAAAAAAAA000][v0].nsp.01")
+    eq("часть 0: вид", p0.kind, Kind.SPLIT_PART)
+    eq("часть 1: вид", p1.kind, Kind.SPLIT_PART)
+    eq("часть: не запускается", p0.runnable, false)
+    eq(
+        "две части - одна запись",
+        LibraryIndex.baseKey("Big Game [0100AAAAAAAAA000][v0].nsp.00") ==
+            LibraryIndex.baseKey("Big Game [0100AAAAAAAAA000][v0].nsp.01"),
+        true
+    )
+    eq("часть обновления - обновление", p0.copy(kind = Kind.UPDATE).kind, Kind.UPDATE)
+    val updPart = LibraryIndex.classify("Big [0100AAAAAAAAA800][v65536][UPD].xci.part01")
+    eq("разрезанное обновление: вид", updPart.kind, Kind.UPDATE)
+
+    // ── распакованная игра ───────────────────────────────────────────────
+    val naked = LibraryIndex.classify("main")
+    eq("main: вид", naked.kind, Kind.UNPACKED)
+    eq("main: запускается", naked.runnable, true)
+    eq("main: имя", naked.title, "main")
+
+    // ── «не игра»: не притворяемся, что папка пуста ──────────────────────
+    val zip = LibraryIndex.classify("backup.7z")
+    eq("архив: вид", zip.kind, Kind.OTHER)
+    check("архив: причина словами", zip.reason.contains("архив"), zip.reason)
+    val txt = LibraryIndex.classify("keys.txt")
+    eq("txt: вид", txt.kind, Kind.OTHER)
+    check("txt: причина без имени класса", !txt.reason.contains(".kt"), txt.reason)
+
+    // ── имена с мусором ──────────────────────────────────────────────────
+    eq(
+        "мусорное имя чистится",
+        LibraryIndex.titleFrom("  [0100AAAAAAAAA000]  Super   Mario  [v0] (1).nsp"),
+        "Super Mario (1)"
+    )
+    eq("пустое имя не падает", LibraryIndex.classify("").kind, Kind.OTHER)
+    eq("имя из одной точки", LibraryIndex.classify(".").kind, Kind.OTHER)
+
+    // ── сводка по папке ──────────────────────────────────────────────────
+    // 200 сжатых + 4 игры + 2 обновления + 3 DLC + мусор.
+    val names = mutableListOf<String>()
+    repeat(200) { names.add("Dump $it [0100AAAAAAAA${"%04X".format(it)}][v0].nsz") }
+    repeat(4) { names.add("Game $it [0100BBBBBBBB${"%04X".format(it)}0000][v0].nsp") }
+    repeat(2) { names.add("Game 0 [0100BBBBBBBB0000${"%04X".format(it + 0x800)}][v${
+        (it + 1) * 65536
+    }][UPD].nsp") }
+    repeat(3) { names.add("Game 0 [0100BBBBBBBB000${"%03X".format(it + 1)}][DLC] x.nsp") }
+    names.add("keys.txt")
+    names.add("readme.md")
+    val s = LibraryIndex.summarise(names)
+    eq("сводка: файлов", s.files, 211)
+    eq("сводка: игр", s.games, 4)
+    eq("сводка: обновлений", s.updates, 2)
+    eq("сводка: DLC", s.dlc, 3)
+    eq("сводка: сжатых", s.compressed, 200)
+    eq("сводка: прочих", s.other, 2)
+    check("сводка: сжатые названы в строке", s.line().contains("200 сжатых"), s.line())
+    check("сводка: игры названы", s.line().contains("4 игры"), s.line())
+
+    // Один и тот же файл, найденный дважды, не удваивает счёт.
+    val dup = LibraryIndex.summarise(listOf("A [0100CCCCCCCC0000][v0].nsp", "A [0100CCCCCCCC0000][v0].nsp"))
+    eq("дубликат схлопнут", dup.games, 1)
+
+    // ── что сломало прошлый обход: имя без точки ─────────────────────────
+    // `getGame()` считал programId как name.substring(0, name.lastIndexOf(".")),
+    // и на файле «main» это substring(0, -1) - исключение на весь обход.
+    val crashProne = LibraryIndex.titleFrom("main")
+    eq("main без точки: имя", crashProne, "main")
+    check(
+        "main без точки: id берётся безопасно",
+        LibraryIndex.titleFrom("main").substringBeforeLast('.', "main") == "main"
+    )
+
+    // ── расхождение с исходниками (то, что модель не поймает) ────────────
+    val root = File(".").absoluteFile
+    val helper = File(root, "patch/android/utils/GameHelper.kt")
+    if (helper.isFile && File(root, "patch/android").isDirectory) {
+        val src = helper.readText()
+        check("GameHelper берёт правило из LibraryIndex", src.contains("LibraryIndex.isWanted"))
+        // В комментарии строка упомянута намеренно - проверяем код, а не
+        // рассказ о нём: ищем именно вызов.
+        check(
+            "GameHelper не режет id через lastIndexOf(\".\")",
+            !src.contains("programId = name.substring(0, name.lastIndexOf")
+        )
+        check("GameHelper не теряет файл при null от getGame", src.contains("side.add(") && src.contains("stats.failed++"))
+        check("GameHelper считает статистику обхода", src.contains("scanStats"))
+
+        val scanner = File(root, "patch/android/utils/GameFolderScanner.kt").readText()
+        check(
+            "сканер не режет обход на 400 папках",
+            !scanner.contains("MAX_DIRECTORIES = 400")
+        )
+        check("сканер считает сжатые", scanner.contains("LibraryIndex.isWanted"))
+
+        val panel = File(root, "patch/android/utils/LivePanel.kt").readText()
+        check("панели есть чем ответить «почему не видно»", panel.contains("libraryReport"))
+
+        val html = File(root, "docs/library.html").readText()
+        val asset = File(root, "patch/android/assets/library.html")
+        check("страница знает про сжатые", html.contains("data-filter=\"dead\"") && html.contains("deadAction"))
+        check("страница показывает сводку", html.contains("paintStats") && html.contains("libraryReport"))
+        if (asset.isFile) {
+            check(
+                "docs/ и assets/ совпадают байт в байт",
+                html == asset.readText()
+            )
+        }
+    } else {
+        println("  note  исходники рядом не найдены - проверка дрейфа пропущена")
+    }
+
+    println()
+    println("passed=$passed failed=$failed")
+    if (failed > 0) {
+        println("failing: ${failures.joinToString(", ")}")
+        kotlin.system.exitProcess(1)
+    }
+}
diff --git a/tests/NativeLibraryPresenterTest.kt b/tests/NativeLibraryPresenterTest.kt
new file mode 100644
index 0000000..08fdcf1
--- /dev/null
+++ b/tests/NativeLibraryPresenterTest.kt
@@ -0,0 +1,281 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Нативный лаунчер: та же логика, что у страницы в WebView, но без WebView.
+//
+// Проверяется [NativeLibraryPresenter] - он и есть вся логика: порядок,
+// бейджи, действия, строка сводки, склонения, тексты диалогов. Экран только
+// рисует. Поэтому тест зовёт настоящий презентер, а не модель.
+//
+// Run: kotlinc tests/NativeLibraryPresenterTest.kt \
+//        patch/android/utils/NativeLibraryPresenter.kt patch/android/utils/LibraryIndex.kt \
+//        -include-runtime -d /tmp/np.jar && java -jar /tmp/np.jar
+
+import java.io.File
+import org.yuzu.yuzu_emu.utils.LibraryIndex
+import org.yuzu.yuzu_emu.utils.Manual
+import org.yuzu.yuzu_emu.utils.NativeLibraryPresenter
+import org.yuzu.yuzu_emu.utils.NativeLibraryPresenter.Action
+
+private var passed = 0
+private var failed = 0
+private val failures = mutableListOf<String>()
+
+private fun check(name: String, ok: Boolean, detail: String = "") {
+    if (ok) {
+        passed++
+        println("  ok    $name${if (detail.isEmpty()) "" else "   [$detail]"}")
+    } else {
+        failed++
+        failures += name
+        println("  FAIL  $name${if (detail.isEmpty()) "" else "   [$detail]"}")
+    }
+}
+
+private fun eq(name: String, actual: Any?, expected: Any?) =
+    check(name, actual == expected, "получено $actual, ожидалось $expected")
+
+fun main() {
+    println("NativeLibraryPresenter — что показывает нативный лаунчер")
+
+    val games = listOf(
+        NativeLibraryPresenter.Row(
+            title = "Sonic Mania", path = "content://a/Sonic Mania [01004E300BD5C000][v0].nsp",
+            titleId = "01004E300BD5C000", developer = "Sega",
+            fileName = "Sonic Mania [01004E300BD5C000][v0].nsp"
+        ),
+        NativeLibraryPresenter.Row(
+            title = "Hollow Knight", path = "content://a/Hollow Knight [0100633007D48000][v0].nsp",
+            titleId = "0100633007D48000", fileName = "Hollow Knight [0100633007D48000][v0].nsp",
+            hasSave = true, saveSize = "3 МБ"
+        ),
+        NativeLibraryPresenter.Row(
+            title = "Zelda", path = "content://a/Zelda [01007EF00011E000][v0].xci",
+            titleId = "01007EF00011E000", fileName = "Zelda [01007EF00011E000][v0].xci"
+        )
+    )
+    val side = listOf(
+        NativeLibraryPresenter.Side(
+            "Hollow Knight [0100633007D48000][v0].nsz", "content://a/x.nsz", "Hollow Knight",
+            "сжатый образ", "compressed"
+        ),
+        NativeLibraryPresenter.Side(
+            "Big [0100AAAAAAAAA000][v0].nsp.00", "content://a/y.00", "Big",
+            "часть разрезанного образа", "split"
+        ),
+        NativeLibraryPresenter.Side(
+            "Metroid Dread [010093801237C000][v0].xci", "content://a/z.xci", "Metroid Dread",
+            "ядро не прочитало заголовок", "unreadable"
+        )
+    )
+
+    val model = NativeLibraryPresenter.build(games, side, updates = 2, dlc = 1)
+
+    // ── порядок и действия ──────────────────────────────────────────────
+    eq("элементов", model.items.size, 6)
+    eq("первым идёт игра", model.items[0].title, "Sonic Mania")
+    eq("игра запускается", model.items[0].action, Action.LAUNCH)
+    eq("сжатый идёт после игр", model.items[3].action, Action.CONVERT)
+    eq("сжатый помечен", model.items[3].note, "сжатый")
+    eq("часть — объяснение, а не распаковка", model.items[4].action, Action.EXPLAIN_SPLIT)
+    eq("непрочитанный просит ключи", model.items[5].action, Action.KEYS)
+    eq("непрочитанный помечен", model.items[5].note, "нет ключей")
+    eq("причина стала подписью", model.items[5].subtitle, "ядро не прочитало заголовок")
+
+    // ── бейджи: расширение, а не иероглиф ───────────────────────────────
+    eq("бейдж nsp", model.items[0].badge, "nsp")
+    eq("бейдж xci", model.items[5].badge, "xci")
+    eq("бейдж nsz", model.items[3].badge, "nsz")
+    eq("у .nsp.00 бейдж от имени без хвоста", model.items[4].badge, "nsp")
+    eq("мусорный бейдж пустой", NativeLibraryPresenter.extensionOf("main"), "")
+    eq("main без расширения не даёт бейдж", NativeLibraryPresenter.extensionOf("файл."), "")
+
+    // ── сводка и склонения ──────────────────────────────────────────────
+    eq(
+        "сводка",
+        model.summary,
+        "3 игры · 2 обновления · 1 DLC · 1 сжатый → Конвертер · 2 не читаются"
+    )
+    eq("1 игра", NativeLibraryPresenter.summaryLine(1, 0, 0, 0, 0), "1 игра")
+    eq("2 игры", NativeLibraryPresenter.summaryLine(2, 0, 0, 0, 0), "2 игры")
+    eq("5 игр", NativeLibraryPresenter.summaryLine(5, 0, 0, 0, 0), "5 игр")
+    eq("11 игр", NativeLibraryPresenter.summaryLine(11, 0, 0, 0, 0), "11 игр")
+    eq("21 игра", NativeLibraryPresenter.summaryLine(21, 0, 0, 0, 0), "21 игра")
+    eq(
+        "сжатых не «1 сжатых»",
+        NativeLibraryPresenter.summaryLine(0, 0, 0, 1, 0),
+        "0 игр · 1 сжатый → Конвертер"
+    )
+
+    // ── пустой экран говорит почему ─────────────────────────────────────
+    val onlyCompressed = NativeLibraryPresenter.build(
+        emptyList(),
+        listOf(
+            NativeLibraryPresenter.Side("a.nsz", "p1", "A", "сжатый образ", "compressed"),
+            NativeLibraryPresenter.Side("b.nsz", "p2", "B", "сжатый образ", "compressed"),
+            NativeLibraryPresenter.Side("c.mp4", "p3", "C", "не образ", "other")
+        )
+    )
+    check(
+        "пустой экран объясняет распаковку",
+        onlyCompressed.emptyReason.contains("2 файла сжаты"),
+        onlyCompressed.emptyReason
+    )
+    check(
+        "пустой экран зовёт Конвертер",
+        onlyCompressed.emptyReason.contains("Конвертер")
+    )
+    val noFolder = NativeLibraryPresenter.build(emptyList(), emptyList())
+    check("совсем пусто — про папку", noFolder.emptyReason.contains("Папка не выбрана"), noFolder.emptyReason)
+    check("совсем пусто не врёт про сжатые", !noFolder.emptyReason.contains("сжаты"))
+
+    // ── поиск и фильтры ─────────────────────────────────────────────────
+    val search = NativeLibraryPresenter.build(games, side, search = "zelda")
+    eq("поиск по названию", search.items.size, 1)
+    eq("поиск нашёл Zelda", search.items[0].title, "Zelda")
+    val searchByTid = NativeLibraryPresenter.build(games, side, search = "01004e30")
+    eq("поиск по Title ID не зависит от регистра", searchByTid.items.size, 1)
+    val dead = NativeLibraryPresenter.build(games, side, filter = NativeLibraryPresenter.FILTER_DEAD)
+    eq("фильтр «не запускается»", dead.items.size, 3)
+    check("в нём только нерабочие", dead.items.none { it.runnable })
+    val runnable = NativeLibraryPresenter.build(games, side, filter = NativeLibraryPresenter.FILTER_RUNNABLE)
+    eq("фильтр «запускается»", runnable.items.size, 3)
+    check("в нём только рабочие", runnable.items.all { it.runnable })
+
+    // ── тексты диалогов: причина, а не имя класса ───────────────────────
+    val (title, body, button) = NativeLibraryPresenter.explain("compressed", "Hollow Knight", "сжатый образ")
+    eq("диалог: заголовок", title, "Hollow Knight")
+    check("диалог: про распаковку", body.contains("распаковывается"), body)
+    eq("диалог: кнопка", button, "Распаковать")
+    val keys = NativeLibraryPresenter.explain("unreadable", "Metroid Dread", "ядро не прочитало заголовок")
+    check("диалог ключей зовёт prod.keys", keys.second.contains("prod.keys"), keys.second)
+    check(
+        "ни одного имени класса в текстах",
+        listOf(body, keys.second).none { it.contains("Exception") || it.contains(".kt") }
+    )
+    val split = NativeLibraryPresenter.explain("split", "Big", "часть разрезанного образа")
+    check("диалог части про целый файл", split.second.contains("целый файл"), split.second)
+
+    // ── связь с правилом «что такое игра» ───────────────────────────────
+    val real = LibraryIndex.classify("Hollow Knight [0100633007D48000][v0].nsz")
+    eq("NSZ остаётся сжатым", real.kind, LibraryIndex.Kind.COMPRESSED)
+    eq("и его бейдж — nsz", NativeLibraryPresenter.extensionOf(real.name), "nsz")
+
+    // ── исходники рядом: экран обязан звать презентер ───────────────────
+    val root = File(".").absoluteFile
+    val fragment = File(root, "patch/android/fragments/NativeLauncherFragment.kt")
+    if (File(root, "patch/android").isDirectory) {
+        check("экран существует", fragment.isFile)
+        if (fragment.isFile) {
+            val src = fragment.readText()
+            check("экран не решает сам, что запускать", src.contains("NativeLibraryPresenter.build"))
+            check("экран берёт причины из презентера", src.contains("NativeLibraryPresenter.explain"))
+            check(
+                "в экране нет WebView",
+                !src.contains("android.webkit.WebView") && !src.contains("WebViewFragment")
+            )
+        }
+        val nav = File(root, "patch/android/navigation/home_navigation.xml")
+        if (nav.isFile) {
+            val xml = nav.readText()
+            check("лаунчер есть в навигации", xml.contains("nativeLauncherFragment"))
+            check(
+                "стартовый экран — нативный лаунчер",
+                Regex("startDestination=\"@id/nativeLauncherFragment\"").containsMatchIn(xml)
+            )
+        }
+    } else {
+        println("  note  дерево patch/ рядом не найдено — проверка дрейфа пропущена")
+    }
+
+    // ── руководство: разделы и экраны, на которые они ссылаются ─────────
+    check("в руководстве есть раздел «с чего начать»", Manual.sections.first().id == "start")
+    check("разделов не меньше шести", Manual.sections.size >= 6, "${Manual.sections.size}")
+    check("у каждого раздела есть шаги", Manual.sections.all { it.steps.isNotEmpty() })
+    check(
+        "ни один раздел не пустой",
+        Manual.sections.all { it.title.isNotBlank() && it.intro.isNotBlank() }
+    )
+    check(
+        "каждый шаг объясняет, а не только называет",
+        Manual.sections.flatMap { it.steps }.all { it.text.length >= 30 },
+        Manual.sections.flatMap { it.steps }.firstOrNull { it.text.length < 30 }?.title ?: ""
+    )
+    check(
+        "поиск находит конвертер",
+        Manual.search("конвертер").isNotEmpty(),
+        "${Manual.search("конвертер").size}"
+    )
+    check("поиск находит ключи", Manual.search("prod.keys").isNotEmpty())
+    check("поиск не находит чепуху", Manual.search("zzzzz").isEmpty())
+    check("пустой запрос отдаёт всё", Manual.search("  ").size == Manual.sections.size)
+    check(
+        "кнопки руководства ведут на разные экраны",
+        Manual.referencedScreens().size >= 6,
+        "${Manual.referencedScreens()}"
+    )
+    check(
+        "руководство ссылается на конвертер, ключи и папки",
+        Manual.referencedScreens().containsAll(
+            listOf(Manual.Go.CONVERT, Manual.Go.KEYS, Manual.Go.FOLDERS)
+        )
+    )
+    check(
+        "в текстах руководства нет имён классов",
+        Manual.sections.none { s ->
+            s.steps.any { it.text.contains("Exception") || it.text.contains(".kt") }
+        }
+    )
+
+    if (File(root, "patch/android").isDirectory) {
+        val manualScreen = File(root, "patch/android/fragments/ManualFragment.kt")
+        check("экран руководства существует", manualScreen.isFile)
+        if (manualScreen.isFile) {
+            val src = manualScreen.readText()
+            check("руководство берёт текст из Manual", src.contains("Manual.sections"))
+            check("руководство умеет искать", src.contains("Manual.search"))
+            check(
+                "в руководстве нет WebView",
+                !src.contains("android.webkit.WebView") && !src.contains("WebViewFragment")
+            )
+        }
+        val navXml = File(root, "patch/android/navigation/home_navigation.xml")
+        if (navXml.isFile) {
+            val xml = navXml.readText()
+            check("руководство есть в навигации", xml.contains("manualFragment"))
+            check(
+                "на руководство есть глобальное действие",
+                xml.contains("action_global_manualFragment")
+            )
+            // Каждая кнопка раздела обязана вести на существующий экран.
+            val actions = listOf(
+                "action_global_symbiosisGameFoldersFragment",
+                "action_global_keysFirmwareFragment",
+                "action_global_toolsFragment",
+                "action_global_enginesFragment",
+                "action_global_fpsTuningFragment",
+                "action_global_diagnosticsFragment",
+                "action_global_guideFragment",
+                "action_global_livePanelFragment"
+            )
+            val missing = actions.filterNot { xml.contains(it) }
+            check("все экраны руководства есть в навигации", missing.isEmpty(), missing.joinToString())
+        }
+        val tools = File(root, "patch/android/fragments/ToolsFragment.kt")
+        if (tools.isFile) {
+            val src = tools.readText()
+            check("в инструментах есть руководство", src.contains("action_global_manualFragment"))
+            check(
+                "старая панель названа расширенной",
+                src.contains("live_panel_extended")
+            )
+        }
+    }
+
+    println()
+    println("passed=$passed failed=$failed")
+    if (failed > 0) {
+        println("failing: ${failures.joinToString(", ")}")
+        kotlin.system.exitProcess(1)
+    }
+}
diff --git a/tools/run_tests.sh b/tools/run_tests.sh
index c52fdb1..c109272 100644
--- a/tools/run_tests.sh
+++ b/tools/run_tests.sh
@@ -104,10 +104,41 @@ done
 
 # Kotlin tests, when a compiler is available.
 if command -v kotlinc >/dev/null 2>&1; then
+  # Sources a Kotlin test compiles against, beyond itself.
+  #
+  # A test that calls real code cannot be built from its own file alone, and
+  # the loop below compiles exactly one file. `LibraryIndexTest` imports
+  # `LibraryIndex`, both plain Kotlin with no Android imports, so the pair
+  # compiles with a bare kotlinc. Anything needing the Android framework is
+  # still modelled, not imported.
+  kt_deps_for() {
+    case "$1" in
+      LibraryIndexTest) echo "$HERE/patch/android/utils/LibraryIndex.kt" ;;
+      # The native launcher keeps its decisions in a presenter and its text in
+      # Manual, both plain Kotlin. A test that calls them should compile against
+      # them rather than against a hand-written copy of the same logic.
+      NativeLibraryPresenterTest) echo "$HERE/patch/android/utils/LibraryIndex.kt \
+        $HERE/patch/android/utils/NativeLibraryPresenter.kt \
+        $HERE/patch/android/utils/Manual.kt" ;;
+      *)                echo "" ;;
+    esac
+  }
+
   for f in "$HERE"/tests/*.kt; do
     [ -e "$f" ] || continue
     n=$(basename "$f" .kt)
-    kotlinc "$f" -include-runtime -d "$BUILD/$n.jar" 2>/dev/null
+    # shellcheck disable=SC2046
+    if ! kotlinc "$f" $(kt_deps_for "$n") -include-runtime -d "$BUILD/$n.jar" \
+          > "$BUILD/$n.kerr" 2>&1; then
+      # A test that does not build used to be reported as "FAIL" with the
+      # reason thrown away (2>/dev/null), which then surfaced as the useless
+      # "Unable to access jarfile". Say what the compiler said instead.
+      why=$(grep -m1 -E "^.*error:" "$BUILD/$n.kerr" | head -1)
+      echo "  FAIL  $n — does not build"
+      echo "        ${why:-no compiler output}"
+      fail=$((fail+1)); failed="$failed $n"
+      continue
+    fi
     # Run from the repository root. A test that reads its own subject - as
     # PanelAssetsTest does, checking docs/ and the shell source against the
     # copy of the routing logic it asserts - resolves those paths relative to
